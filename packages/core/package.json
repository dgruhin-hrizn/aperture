    "@ai-sdk/huggingface": "^2.0.84",
    "@ai-sdk/openai": "^4.0.108",
    "@ai-sdk/openai-compatible": "^3.0.84",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.162",
    "ai-sdk-ollama": "4.6.2",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "sharp": "^0.33.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2"
  }
